# Git 属性：统一行尾、标记二进制、改善 diff
# https://git-scm.com/docs/gitattributes

# 仓库内一律存 LF，检出也强制 LF，避免跨系统互相 diff 出整文件变更
* text=auto eol=lf

# 批处理 / PowerShell 必须 CRLF 才能执行
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# CRLF 会导致 bad interpreter
*.sh  text eol=lf
/mvnw text eol=lf

# 文本文件与 diff 优化
*.java       text diff=java
*.md         text diff=markdown
*.xml        text
*.yml        text
*.yaml       text
*.json       text
*.properties text
*.sql        text
*.log        text

# 二进制文件。不声明的话 Git 可能按文本处理并做行尾转换，把文件改坏
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.bmp   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.jar   binary
*.war   binary
*.class binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.woff  binary
*.woff2 binary
*.keystore binary
*.jks   binary

# SVG 是文本，可以做 diff
*.svg   text

# 生成内容，不参与 diff、不计入语言统计
target/**  -diff linguist-generated
logs/**    -diff linguist-generated
**/src/main/*/META-INF/** -diff linguist-generated
